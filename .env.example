# Local dev: localhost auto-detected. For tunnels (ngrok/cloudflared) or staging, set this.
SNAP_PUBLIC_BASE_URL=https://your-snap.vercel.app

# Dev only: skip JFS signature verification so you can hit endpoints without a signed Farcaster client request.
# DO NOT set in production. Production must verify against Farcaster Hub.
SKIP_JFS_VERIFICATION=true
